# ---------------------------------------------------------------------------
# Google Ads API credentials.  Copy to .env and fill in.
# See docs/developer-token-application.md and docs/oauth-setup.md.
# ---------------------------------------------------------------------------

# From your MANAGER (MCC) account: Tools & Settings -> Setup -> API Center
GOOGLE_ADS_DEVELOPER_TOKEN=

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client
# (application type: Desktop app)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Produced by: python scripts/setup_oauth.py
GOOGLE_ADS_REFRESH_TOKEN=

# Your MCC id, digits only (no dashes).  Every request is made "as" this manager.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional: default client account to operate on when --account is omitted.
GOOGLE_ADS_DEFAULT_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------

# MOCK=1 runs everything against gads/mock fixtures - no credentials needed.
# Use this until your developer token is approved.
GADS_MOCK=0

# Global kill switch.  1 = never send a real mutate call, no matter what the
# guardrail config says.  Every write is validated and logged instead.
GADS_READ_ONLY=0

# Where audit logs and rollback files are written.
GADS_AUDIT_DIR=./.audit

# Optional Census API key (https://api.census.gov/data/key_signup.html).
# Not required for the low request volumes this agent makes.
CENSUS_API_KEY=
